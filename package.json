{
  "name": "pi-copy-picker",
  "version": "1.0.0",
  "description": "Fullscreen current-branch message copy picker for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/tallshort/pi-copy-picker/main/gallery-preview.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:release": "node --test scripts/release.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run test:release && npm run check:package",
    "prepack": "npm run check",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "author": "tallshort",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tallshort/pi-copy-picker.git"
  },
  "homepage": "https://github.com/tallshort/pi-copy-picker#readme",
  "bugs": {
    "url": "https://github.com/tallshort/pi-copy-picker/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "src/",
    "gallery-preview.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASING.md"
  ]
}
